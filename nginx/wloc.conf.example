# nginx conf.d/*.conf included INSIDE http {} only.
limit_req_zone $binary_remote_addr zone=wloc_api:10m rate=12r/m;
limit_conn_zone $binary_remote_addr zone=wloc_concurrent:10m;

server {
    listen 443 ssl;
    # 部署前将 wloc.example.com 统一替换为实际域名，并确认对应证书路径。
    server_name wloc.example.com;

    ssl_certificate     /etc/nginx/ssl/wloc.example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/wloc.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 16k;

    # Safari 页面与 API 共享认证领域，Safari 同源 fetch 可复用认证。
    auth_basic "WLOC Private";
    auth_basic_user_file /etc/nginx/.wloc.htpasswd;

    # 代理脚本下载路径需要匿名访问；只公开这几个固定文件。
    location = /wloc.module {
        auth_basic off;
        default_type text/plain;
        alias /var/www/wloc/wloc.module;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /scripts/wloc.js {
        auth_basic off;
        default_type application/javascript;
        alias /var/www/wloc/scripts/wloc.js;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /scripts/wloc-settings.js {
        auth_basic off;
        default_type application/javascript;
        alias /var/www/wloc/scripts/wloc-settings.js;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /wloc.jpg {
        auth_basic off;
        default_type image/jpeg;
        alias /var/www/wloc/wloc.jpg;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /api/parse {
        limit_req zone=wloc_api burst=5 nodelay;
        limit_req_status 429;
        limit_conn wloc_concurrent 2;
        limit_conn_status 429;
        access_log off;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 45s;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 45s;
    }
}
